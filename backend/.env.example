# TEST MODE Environment Variables
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_DB_PASSWORD@aws-YOUR-REGION.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
STRIPE_SECRET_KEY=sk_test_PASTE_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_PASTE_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_PRICE_ID=price_PASTE_YOUR_PRICE_ID_HERE
STRIPE_WEBHOOK_SECRET=whsec_PASTE_WEBHOOK_SECRET_HERE
PORT=3000

# ========================================
# SETUP INSTRUCTIONS (TEST MODE)
# ========================================

# 1. CONNECT SUPABASE
#    Open Supabase Dashboard > Connect
#    Copy the Transaction pooler URI for serverless deployments
#    Username format must stay: postgres.[project-ref]
#    If your DB password contains special characters, URL-encode it in DATABASE_URL
#
# 2. CREATE STRIPE ACCOUNT (Free)
#    Go to: https://dashboard.stripe.com/register
#    Sign up with email

# 3. ENABLE TEST MODE
#    Toggle "Test mode" switch in top-right corner
#    (Should show "Test mode" badge)

# 4. GET API KEYS
#    Go to: https://dashboard.stripe.com/test/apikeys
#    Copy "Secret key" (starts with sk_test_)
#    Copy "Publishable key" (starts with pk_test_)
#    Paste both above

# 5. CREATE PRODUCT
#    Go to: https://dashboard.stripe.com/test/products
#    Click "Add product"
#    Name: "ApplySafe Pro"
#    Price: $9.99 USD
#    Billing: Recurring monthly
#    Click "Save product"
#    Copy the Price ID (starts with price_)
#    Paste above in STRIPE_PRICE_ID

# 6. SETUP WEBHOOK (Optional for local testing)
#    Go to: https://dashboard.stripe.com/test/webhooks
#    Click "Add endpoint"
#    URL: http://localhost:3000/api/webhook
#    Events: Select all checkout and subscription events
#    Copy signing secret (starts with whsec_)
#    Paste above

# 7. START BACKEND
#    Copy this file to .env (remove .example)
#    Run: npm install
#    Run: npm start

# ========================================
# TEST CARDS (Use these in checkout)
# ========================================
# Success: 4242 4242 4242 4242
# Decline: 4000 0000 0000 0002
# Requires 3DS: 4000 0027 6000 3184
# Any future expiry date (e.g., 12/34)
# Any 3-digit CVC
# Any ZIP code

# NOTE: Test mode charges won't create real transactions!
# Switch to Live mode when ready for production.
