{
  "manifest_version": 3,
  "name": "ApplySafe - Job Scam Detector",
  "version": "3.0.0",
  "key": "",
  "description": "Job scam detection for LinkedIn, Indeed, and more. Review suspicious listings with fast, clear signals before you apply.",
  "icons": {
    "16": "icons/icon16.png",
    "19": "icons/icon19.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "38": "icons/icon38.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "19": "icons/icon19.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "38": "icons/icon38.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ApplySafe - Review job posting signals",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "alarms",
    "notifications",
    "contextMenus",
    "identity"
  ],
  "oauth2": {
    "client_id": "595499212327-3ii1pt2tfavmart3i9i0d378q9ui6ccp.apps.googleusercontent.com",
    "scopes": [
      "profile",
      "email"
    ]
  },
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.indeed.com/*",
    "https://indeed.com/*",
    "https://www.glassdoor.com/*",
    "https://glassdoor.com/*",
    "https://www.ziprecruiter.com/*",
    "https://www.monster.com/*",
    "https://www.simplyhired.com/*",
    "https://www.dice.com/*",
    "https://www.careerbuilder.com/*",
    "https://angel.co/*",
    "https://wellfound.com/*",
    "https://www.upwork.com/*",
    "https://www.flexjobs.com/*",
    "https://www.remote.co/*",
    "https://weworkremotely.com/*",
    "https://remoteok.com/*",
    "https://careers.google.com/*",
    "https://www.google.com/about/careers/*",
    "https://api.anthropic.com/*",
    "https://h1bdata.info/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.workday.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.bamboohr.com/*",
    "https://*.icims.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.jobvite.com/*",
    "https://*.taleo.net/*",
    "https://*.breezy.hr/*",
    "https://*.ashbyhq.com/*",
    "https://*.recruitee.com/*",
    "https://applysafe-version1.vercel.app/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*",
        "https://www.indeed.com/*",
        "https://indeed.com/*",
        "https://www.glassdoor.com/job-listing/*",
        "https://www.glassdoor.com/Job/*",
        "https://www.ziprecruiter.com/jobs/*",
        "https://www.monster.com/job-openings/*",
        "https://www.simplyhired.com/job/*",
        "https://www.dice.com/job-detail/*",
        "https://www.careerbuilder.com/job-*",
        "https://angel.co/jobs/*",
        "https://wellfound.com/jobs/*",
        "https://www.upwork.com/jobs/*",
        "https://www.flexjobs.com/job/*",
        "https://www.remote.co/job/*",
        "https://weworkremotely.com/remote-jobs/*",
        "https://remoteok.com/*",
        "https://careers.google.com/jobs/*",
        "https://www.google.com/about/careers/applications/jobs/*",
        "https://*.greenhouse.io/jobs/*",
        "https://boards.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.wd5.myworkdayjobs.com/*",
        "https://*.bamboohr.com/careers/*",
        "https://*.icims.com/jobs/*",
        "https://*.smartrecruiters.com/*/jobs/*",
        "https://*.jobvite.com/*",
        "https://*.taleo.net/*",
        "https://*.breezy.hr/*",
        "https://*.ashbyhq.com/*",
        "https://*.recruitee.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "assets/*", "dashboard/*", "landing/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; trusted-types default 'allow-duplicates';"
  }
}
